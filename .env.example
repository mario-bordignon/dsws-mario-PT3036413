# Copie este arquivo para ".env" e preencha com seus dados reais.
# NUNCA suba o arquivo ".env" (com os valores reais) para o GitHub.

FLASK_APP=flasky.py
# development (padrão), testing ou production
FLASK_CONFIG=development
SECRET_KEY=troque-por-uma-chave-secreta

MAILGUN_API_URL=https://api.mailgun.net/v3/SEU_DOMINIO_SANDBOX.mailgun.org/messages
MAILGUN_API_KEY=sua-sending-key-do-mailgun
MAILGUN_FROM=Mailgun Sandbox <postmaster@SEU_DOMINIO_SANDBOX.mailgun.org>

# Contas autorizadas no Mailgun (escolha qual usar em config.py: FLASKY_CAIXA_TESTE)
FLASKY_CAIXA1=email-da-caixa-1@exemplo.com
FLASKY_CAIXA2=email-da-caixa-2@exemplo.com
